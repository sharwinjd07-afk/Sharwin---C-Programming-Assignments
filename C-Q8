#include <stdio.h>

int main()
{
    int experience, performance;

    scanf("%d", &experience);
    scanf("%d", &performance);

    if (experience < 3)
    {
        printf("Level: Junior\n");
    }
    else if (experience <= 7)
    {
        if (performance >= 80)
        {
            printf("Level: Mid-Level\n");
        }
        else
        {
            printf("Level: Junior\n");
        }
    }
    else
    {
        if (performance >= 85)
        {
            printf("Level: Senior\n");
        }
        else
        {
            printf("Level: Mid-Level\n");
        }
    }

    return 0;
}
