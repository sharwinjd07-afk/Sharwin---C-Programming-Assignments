#include <stdio.h>

int main()
{
    int answered, time, submitted;

    printf("Questions Answered: ");
    scanf("%d", &answered);

    printf("Remaining Time: ");
    scanf("%d", &time);

    printf("Already Submitted (1=Yes, 0=No): ");
    scanf("%d", &submitted);

    if (answered >= 1 && time > 0 && submitted == 0)
    {
        printf("Submission Allowed\n");
    }
    else
    {
        printf("Submission Not Allowed\n");
    }

    return 0;
}
